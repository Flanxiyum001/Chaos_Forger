{
  "interval_seconds": 5,
  "chaos_probability": 0.6,
  "docker_socket": "/var/run/docker.sock",
  "stop_timeout_seconds": 10,

  "dry_run": true,
  "max_actions_per_cycle": 1,
  "max_actions_per_run": 10,

  "log_level": "info",
  "targets": [
    { "name_match": "forger-web",   "action": "stop" },
    { "name_match": "forger-cache", "action": "kill" }
  ]
}
